@inject Darge.Web.Services.ILocalizationService Loc
@model Darge.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = Loc.Get("NavDashboard");

    // Gather pending tasks across active projects for Today's Tasks
    var todayTasks = Model.Projects
        .SelectMany(p => p.Tasks.Where(t => !t.IsCompleted).Select(t => new { Project = p, Task = t }))
        .Take(5)
        .ToList();
}

<div class="container-fluid py-2">

    <!-- PAGE TITLE INSIDE CONTENT (REQ 1) -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-slate-900">@Loc.Get("WelcomeBack"), @Model.Username 👋</h2>
            <p class="text-slate-600 mb-0">@Loc.Get("DashboardSub")</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-xp fs-6 px-3 py-2 rounded-pill">
                ⭐ @Loc.Get("LevelGardener") @Model.Level
            </span>
            <a asp-controller="Projects" asp-action="Plan" class="btn btn-emerald rounded-pill px-3">
                ✨ @Loc.Get("NavPlanWithAI")
            </a>
            <a asp-controller="Projects" asp-action="Create" class="btn btn-orange rounded-pill px-4">
                + @Loc.Get("NewProject")
            </a>
        </div>
    </div>

    <!-- METRICS OVERVIEW ROW (SEMANTIC COLOR SURFACES) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 surface-xp h-100">
                <small class="text-uppercase fw-bold text-xp d-block mb-1">@Loc.Get("TotalXP")</small>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-3 fw-bold text-xp">@Model.Xp</span>
                    <span class="text-xp small">XP</span>
                </div>
                <small class="text-slate-600 d-none d-sm-block">@Loc.Get("LevelGardener") @Model.Level (@Model.XpInCurrentLevel / @Model.XpToNextLevel XP)</small>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 surface-project h-100">
                <small class="text-uppercase fw-bold text-project d-block mb-1">@Loc.Get("ActiveProjects")</small>
                <div class="fs-3 fw-bold text-project">@Model.ProjectCount</div>
                <small class="text-slate-600 d-none d-sm-block">@Model.Projects.Count @Loc.Get("ActiveProjects")</small>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 surface-task h-100">
                <small class="text-uppercase fw-bold text-task d-block mb-1">@Loc.Get("TaskCompletion")</small>
                <div class="fs-3 fw-bold text-task">@Model.CompletedTasks <span class="fs-6 text-slate-600">/ @Model.TotalTasks</span></div>
                <small class="text-slate-600 d-none d-sm-block">@Model.TaskProgressPercent% Complete</small>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 surface-ai h-100">
                <small class="text-uppercase fw-bold text-ai d-block mb-1">@Loc.Get("UnlockedBadges")</small>
                <div class="fs-3 fw-bold text-ai">🏆 @Model.Achievements.Count</div>
                <small class="text-slate-600 d-none d-sm-block">@Loc.Get("UnlockedMilestone")</small>
            </div>
        </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT GRID -->
    <div class="row g-4 mb-4">

        <!-- TODAY'S TASKS (LEFT COLUMN) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0 text-slate-900">⚡ @Loc.Get("ActionItems")</h4>
                    <span class="badge badge-task border px-3 py-1 rounded-pill">
                        @todayTasks.Count @Loc.Get("PendingActions")
                    </span>
                </div>

                @if (todayTasks.Count == 0)
                {
                    <div class="p-4 bg-slate-100 rounded-3 text-center">
                        <div class="fs-2 mb-2">🎉</div>
                        <h5 class="fw-bold mb-1 text-slate-900">@Loc.Get("AllCaughtUp")</h5>
                        <p class="text-slate-600 small mb-0">@Loc.Get("NoPendingTasks")</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in todayTasks)
                        {
                            string badgeClass = item.Task.TaskLevel switch
                            {
                                "Easy" => "bg-info-subtle text-info border-info-subtle",
                                "Medium" => "bg-warning-subtle text-warning border-warning-subtle",
                                "Hard" => "bg-danger-subtle text-danger border-danger-subtle",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <div class="p-3 border rounded-3 surface-task d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <span class="badge badge-emerald mb-1">🌱 @item.Project.PlantName</span>
                                    <h6 class="fw-bold text-slate-900 mb-1">@item.Task.TaskName</h6>
                                    @if (!string.IsNullOrWhiteSpace(item.Task.TaskDescription))
                                    {
                                        <small class="text-slate-600 d-block mb-1">@item.Task.TaskDescription</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Task.TaskLevel))
                                    {
                                        <small class="badge border @badgeClass me-2">@item.Task.TaskLevel</small>
                                    }
                                    <small class="text-xp fw-bold">+@item.Task.XpReward XP</small>
                                </div>

                                <div>
                                    <form asp-controller="Projects" asp-action="CompleteTask" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@item.Task.Id" />
                                        <input type="hidden" name="projectId" value="@item.Project.Id" />
                                        <input type="hidden" name="returnUrl" value="/Dashboard" />
                                        <button type="submit" class="btn btn-emerald btn-sm rounded-pill px-3">
                                            ✓ @Loc.Get("MarkComplete")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ACTIVE PROJECTS PREVIEW -->
            <div class="card border-0 shadow-sm bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0 text-slate-900">🌿 @Loc.Get("ActiveProjects")</h4>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill">
                        @Loc.Get("ViewAllProjects") (@Model.ProjectCount)
                    </a>
                </div>

                @if (Model.Projects.Count == 0)
                {
                    <div class="p-4 bg-slate-100 rounded-3 text-center">
                        <div class="fs-2 mb-2">🪴</div>
                        <h5 class="fw-bold text-slate-900">@Loc.Get("NoActiveProjects")</h5>
                        <p class="text-slate-600 small mb-3">@Loc.Get("StartGardenJourney")</p>
                        <a asp-controller="Projects" asp-action="Plan" class="btn btn-emerald rounded-pill px-4">
                            ✨ @Loc.Get("NavPlanWithAI")
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var project in Model.Projects.Take(4))
                        {
                            int completed = project.Tasks.Count(t => t.IsCompleted);
                            int total = project.Tasks.Count;
                            double pct = total == 0 ? 0 : Math.Round((double)completed / total * 100);
                            var nextTask = project.Tasks.FirstOrDefault(t => !t.IsCompleted);

                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 surface-project h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-slate-900 mb-0">🌱 @project.PlantName</h5>
                                            <span class="badge badge-project">@project.Space m²</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(project.Location))
                                        {
                                            <p class="text-slate-600 small mb-2">📍 @project.Location</p>
                                        }

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between small text-slate-600 mb-1 fw-semibold">
                                                <span>@Loc.Get("TaskCompletion")</span>
                                                <span>@completed / @total Tasks (@pct%)</span>
                                            </div>
                                            <div class="progress rounded-pill" style="height: 6px;">
                                                <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: @pct%"></div>
                                            </div>
                                        </div>

                                        @if (nextTask != null)
                                        {
                                            <div class="p-2 bg-white rounded-2 small text-slate-700 mb-3 border">
                                                <span class="text-project fw-bold">@Loc.Get("NextAction")</span> @nextTask.TaskName
                                            </div>
                                        }
                                        else if (total > 0)
                                        {
                                            <div class="p-2 bg-success-subtle text-success rounded-2 small mb-3 fw-bold">
                                                @Loc.Get("AllTasksComplete")
                                            </div>
                                        }
                                    </div>

                                    <div>
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-dark w-100 btn-sm rounded-pill">
                                            @Loc.Get("OpenProjectDetails")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SIDEBAR WIDGETS (RIGHT COLUMN) -->
        <div class="col-lg-4">

            <!-- AI INSIGHT CARD -->
            <div class="card border-0 shadow-sm surface-ai p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fs-4">🤖</span>
                    <h5 class="fw-bold mb-0 text-ai">@Loc.Get("AIInsightTitle")</h5>
                </div>
                <p class="text-slate-700 small mb-3">
                    @Loc.Get("AIInsightDesc")
                </p>
                <a asp-controller="Assistant" asp-action="Index" class="btn btn-emerald w-100 rounded-pill py-2">
                    @Loc.Get("AskAIWhatNeedsAttention") →
                </a>
            </div>

            <!-- GAMIFICATION & ACHIEVEMENTS WIDGET -->
            <div class="card border-0 shadow-sm bg-white p-4">
                <h5 class="fw-bold mb-3 text-slate-900">🏆 @Loc.Get("AchievementsLevel")</h5>

                <div class="mb-3">
                    <div class="d-flex justify-content-between small fw-bold text-slate-700 mb-1">
                        <span>@Loc.Get("LevelGardener") @Model.Level</span>
                        <span>@Model.XpInCurrentLevel / @Model.XpToNextLevel XP</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 10px;">
                        <div class="progress-bar progress-bar-ochre rounded-pill" role="progressbar" style="width: @Model.LevelProgress%"></div>
                    </div>
                </div>

                <hr class="my-3" />

                <h6 class="fw-bold mb-2 text-slate-800">@Loc.Get("RecentMilestones")</h6>
                @if (Model.Achievements.Count == 0)
                {
                    <p class="text-slate-600 small mb-0">@Loc.Get("NoAchievementsUnlocked")</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var achievement in Model.Achievements.Take(4))
                        {
                            <div class="p-2 border rounded-3 surface-xp d-flex align-items-center gap-2 small">
                                <span class="fs-5">🏆</span>
                                <span class="fw-bold text-xp">@achievement</span>
                            </div>
                        }
                    </div>
                }

                <div class="mt-3 text-center">
                    <a asp-controller="Dashboard" asp-action="Profile" class="text-emerald small fw-bold text-decoration-none">
                        @Loc.Get("ViewFullProfile") →
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>
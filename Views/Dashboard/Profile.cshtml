@model Darge.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Profile & Account";
}

<div class="container-fluid py-2" style="max-width: 900px;">

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="p-4 text-white text-center position-relative" style="background-color: var(--sidebar-bg);">
            <div class="fs-1 mb-2">🧑‍🌾</div>
            <h2 class="fw-bold mb-1">@Model.Username</h2>
            <span class="badge bg-white text-emerald fs-6 rounded-pill px-3 py-1 shadow-sm">
                ⭐ Level @Model.Level Gardener
            </span>
        </div>

        <div class="card-body p-4">
            <div class="row text-center g-3 mb-4">
                <div class="col-4">
                    <div class="p-3 bg-slate-100 rounded-3">
                        <small class="text-muted text-uppercase d-block fw-bold">Experience</small>
                        <span class="fs-4 fw-bold text-emerald">@Model.Xp XP</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-slate-100 rounded-3">
                        <small class="text-muted text-uppercase d-block fw-bold">Active Projects</small>
                        <span class="fs-4 fw-bold text-slate-900">@Model.ProjectCount</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-slate-100 rounded-3">
                        <small class="text-muted text-uppercase d-block fw-bold">Task Progress</small>
                        <span class="fs-4 fw-bold text-slate-900">@Model.CompletedTasks / @Model.TotalTasks</span>
                    </div>
                </div>
            </div>

            <!-- LEVEL PROGRESS BAR -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold text-slate-700">
                    <span>Level @Model.Level Gardener</span>
                    <span>@Model.XpInCurrentLevel / @Model.XpToNextLevel XP to Level @(Model.Level + 1)</span>
                </div>
                <div class="progress rounded-pill" style="height: 10px;">
                    <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: @Model.LevelProgress%"></div>
                </div>
            </div>

            <hr class="my-4" />

            <h4 class="fw-bold text-slate-900 mb-3">🏆 Achievements Unlocked (@Model.Achievements.Count)</h4>

            @if (Model.Achievements.Count == 0)
            {
                <div class="text-center py-4 bg-slate-100 rounded-3">
                    <p class="text-muted mb-0">No achievements unlocked yet. Create projects and complete tasks to earn milestone badges!</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (string achievement in Model.Achievements)
                    {
                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-3 border rounded-3 bg-success-subtle border-success-subtle">
                                <span class="fs-3 me-3">🏆</span>
                                <div>
                                    <h6 class="fw-bold mb-0 text-success-emphasis">@achievement</h6>
                                    <small class="text-success me-2">Unlocked Milestone</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="text-center">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            ← Back to Dashboard
        </a>
    </div>

</div>
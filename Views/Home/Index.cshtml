@inject Darge.Web.Services.ILocalizationService Loc

@{
    ViewData["Title"] = Loc.Get("BrandTagline");
    Layout = "_MarketingLayout";
}

<!-- ASYMMETRIC / SPLIT TINTED HERO SECTION -->
<section class="hero-section py-5 position-relative surface-project border-bottom">
    <div class="container py-4 py-lg-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge badge-emerald px-3 py-2 rounded-pill fw-bold mb-3 d-inline-block shadow-sm">
                    🌱 @Loc.Get("LandingHeroTagline")
                </span>

                <h1 class="display-4 fw-bold text-slate-900 mb-3 tracking-tight">
                    @Loc.Get("LandingHeroTitle")
                </h1>

                <p class="fs-5 text-slate-700 mb-4 leading-relaxed">
                    @Loc.Get("LandingHeroDesc")
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-emerald btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
                        @Loc.Get("NavGetStarted") →
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-lg rounded-pill px-4 py-3 fw-semibold">
                        @Loc.Get("NavSignIn")
                    </a>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3 text-slate-700 small fw-semibold">
                    <span>@Loc.Get("HeroFeature1")</span>
                    <span>@Loc.Get("HeroFeature2")</span>
                    <span>@Loc.Get("HeroFeature3")</span>
                </div>
            </div>

            <!-- PRODUCT WORKFLOW PREVIEW CARDS (RIGHT SIDE) -->
            <div class="col-lg-6">
                <div class="d-flex flex-column gap-3">

                    <!-- PROJECT PREVIEW CARD -->
                    <div class="card border-0 shadow-lg bg-white p-4 rounded-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge badge-project mb-1">📍 Tbilisi Balcony · 4.5 m²</span>
                                <h4 class="fw-bold text-slate-900 mb-0">🌱 @Loc.Get("MockTomatoes")</h4>
                            </div>
                            <span class="badge badge-emerald px-3 py-1">60%</span>
                        </div>

                        <div class="progress my-3 rounded-pill" style="height: 10px;">
                            <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: 60%"></div>
                        </div>

                        <!-- MOCK AI ADVICE BUBBLE -->
                        <div class="p-3 surface-ai rounded-3 border">
                            <div class="d-flex align-items-center gap-2 text-ai fw-bold small mb-1">
                                <span>🤖 DARGE AI:</span>
                            </div>
                            <p class="text-slate-800 small mb-0 fw-semibold">
                                "@Loc.Get("MockAiQuote")"
                            </p>
                        </div>
                    </div>

                    <!-- TASK & XP PREVIEW CARD -->
                    <div class="card border-0 shadow surface-task p-3 rounded-4 d-flex flex-row justify-content-between align-items-center">
                        <div>
                            <span class="badge badge-task mb-1">@Loc.Get("NextAction")</span>
                            <h6 class="fw-bold text-slate-900 mb-0">@Loc.Get("MockTaskTitle")</h6>
                        </div>
                        <span class="badge badge-xp px-3 py-2 fs-6">+20 XP</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- TINTED FEATURE CARDS SECTION -->
<section class="py-5 surface-ai border-bottom">
    <div class="container py-4">
        <div class="text-center max-w-xl mx-auto mb-5">
            <h2 class="fw-bold text-slate-900 mb-2">@Loc.Get("WhyDargeTitle")</h2>
            <p class="text-slate-700 mb-0">@Loc.Get("WhyDargeSub")</p>
        </div>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-white border shadow-sm h-100 card-hover">
                    <div class="fs-1 mb-3">🌿</div>
                    <h5 class="fw-bold text-slate-900 mb-2">@Loc.Get("Feature1Title")</h5>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Feature1Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-white border shadow-sm h-100 card-hover">
                    <div class="fs-1 mb-3">⚡</div>
                    <h5 class="fw-bold text-slate-900 mb-2">@Loc.Get("Feature2Title")</h5>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Feature2Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-white border shadow-sm h-100 card-hover">
                    <div class="fs-1 mb-3">🤖</div>
                    <h5 class="fw-bold text-slate-900 mb-2">@Loc.Get("Feature3Title")</h5>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Feature3Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-white border shadow-sm h-100 card-hover">
                    <div class="fs-1 mb-3">🏆</div>
                    <h5 class="fw-bold text-slate-900 mb-2">@Loc.Get("Feature4Title")</h5>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Feature4Desc")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WORKFLOW STEP-BY-STEP SECTION -->
<section class="py-5 surface-task border-bottom">
    <div class="container py-4">
        <div class="text-center max-w-xl mx-auto mb-5">
            <h2 class="fw-bold text-slate-900 mb-2">@Loc.Get("WorkflowTitle")</h2>
            <p class="text-slate-700 mb-0">@Loc.Get("WorkflowSub")</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                    <div class="fs-2 text-emerald fw-bold mb-2">1</div>
                    <h6 class="fw-bold text-slate-900 mb-2">@Loc.Get("Step1Title")</h6>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Step1Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                    <div class="fs-2 text-emerald fw-bold mb-2">2</div>
                    <h6 class="fw-bold text-slate-900 mb-2">@Loc.Get("Step2Title")</h6>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Step2Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                    <div class="fs-2 text-emerald fw-bold mb-2">3</div>
                    <h6 class="fw-bold text-slate-900 mb-2">@Loc.Get("Step3Title")</h6>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Step3Desc")</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                    <div class="fs-2 text-emerald fw-bold mb-2">4</div>
                    <h6 class="fw-bold text-slate-900 mb-2">@Loc.Get("Step4Title")</h6>
                    <p class="text-slate-600 small mb-0">@Loc.Get("Step4Desc")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION SECTION -->
<section class="py-5 surface-xp">
    <div class="container py-4 text-center">
        <div class="card border-0 shadow-lg bg-white p-5 rounded-4 max-w-xl mx-auto">
            <h2 class="fw-bold text-slate-900 mb-3">@Loc.Get("CtaTitle")</h2>
            <p class="text-slate-700 mb-4">@Loc.Get("CtaSub")</p>
            <div>
                <a asp-controller="Account" asp-action="Register" class="btn btn-emerald btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
                    @Loc.Get("NavGetStarted") →
                </a>
            </div>
        </div>
    </div>
</section>
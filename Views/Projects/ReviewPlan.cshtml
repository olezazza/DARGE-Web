@inject Darge.Web.Services.ILocalizationService Loc
@model Darge.Web.Models.AiProjectPlanResponse

@{
    ViewData["Title"] = Loc.Get("ReviewPlanTitle");
    var origReq = ViewBag.OriginalRequest as Darge.Web.Models.AiProjectPlanRequest;
    string rawTasksJson = System.Text.Json.JsonSerializer.Serialize(Model.Tasks);
    string tasksBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(rawTasksJson));
}

<div class="container py-3" style="max-width: 900px;">

    <!-- PAGE TITLE INSIDE CONTENT (REQ 1) -->
    <div class="mb-3">
        <a asp-action="Plan" class="text-decoration-none text-emerald fw-semibold">
            ← @Loc.Get("PlanWithAITitle")
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <span class="badge badge-ai px-3 py-1 rounded-pill mb-2">
                    ✨ DARGE AI Generated Plan
                </span>
                <h1 class="fw-bold mb-1 text-slate-900">🌱 @Model.ProjectTitle</h1>
                <p class="text-slate-600 fs-5 mb-0">Plant: <strong>@Model.PlantName</strong></p>
            </div>
            <div>
                <a asp-action="Plan" class="btn btn-outline-secondary rounded-pill">
                    🔄 @Loc.Get("RegeneratePlan")
                </a>
            </div>
        </div>

        <!-- OVERVIEW & RECOMMENDATIONS -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="p-3 surface-project rounded-3 h-100">
                    <h5 class="fw-bold mb-2 text-project">📝 @Loc.Get("Summary")</h5>
                    <p class="text-slate-800 mb-0">@Model.Summary</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 surface-ai rounded-3 h-100">
                    <h5 class="fw-bold mb-2 text-ai">💡 @Loc.Get("Recommendations")</h5>
                    <p class="text-slate-800 mb-0">@Model.Recommendations</p>
                </div>
            </div>
        </div>

        <form asp-action="CreateFromPlan" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tasksBase64" value="@tasksBase64" />

            <!-- EDITABLE PROJECT ATTRIBUTES -->
            <h4 class="fw-bold mb-3 text-slate-900">@Loc.Get("ProjectAttributes")</h4>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("PlantNameLabel")</label>
                    <input name="plantName" value="@Model.PlantName" class="form-control rounded-3" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("Location")</label>
                    <input name="location" value="@(origReq?.Location ?? "Garden")" class="form-control rounded-3" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("SoilType")</label>
                    <input name="soilType" value="@(origReq?.SoilType ?? "General Mix")" class="form-control rounded-3" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("Space") (m²)</label>
                    <input name="space" type="number" step="0.1" value="@(origReq?.Space ?? 2.0)" class="form-control rounded-3" required />
                </div>
            </div>

            <!-- GENERATED TASKS -->
            <h4 class="fw-bold mb-3 text-slate-900">@Loc.Get("GeneratedTasks") (@Model.Tasks.Count)</h4>
            <div class="d-flex flex-column gap-3 mb-4">
                @for (int i = 0; i < Model.Tasks.Count; i++)
                {
                    var task = Model.Tasks[i];
                    <div class="card border rounded-3 p-3 surface-task">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold text-slate-900">Step @(i + 1):</span>
                                    <h5 class="fw-bold text-slate-900 mb-0">@task.Title</h5>
                                    @if (!string.IsNullOrWhiteSpace(task.Difficulty))
                                    {
                                        <span class="badge badge-task ms-2">
                                            @Loc.Get(task.Difficulty) · +@task.XpReward XP
                                        </span>
                                    }
                                </div>
                                <p class="text-slate-700 small mb-1">@task.Description</p>
                                @if (!string.IsNullOrWhiteSpace(task.Timing))
                                {
                                    <small class="text-emerald fw-semibold">⏱️ Timing: @task.Timing</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="p-4 surface-project rounded-4 text-center border">
                <h5 class="fw-bold text-project mb-2">@Loc.Get("ReadyToStart")</h5>
                <p class="text-slate-700 mb-3">@Loc.Get("ReadySub")</p>
                <button type="submit" class="btn btn-emerald btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
                    🌱 @Loc.Get("CreateThisProjectBtn")
                </button>
            </div>
        </form>
    </div>

</div>

@model Darge.Web.Models.AiProjectPlanResponse

@{
    ViewData["Title"] = "Review AI Plan";
    var origReq = ViewBag.OriginalRequest as Darge.Web.Models.AiProjectPlanRequest;
    string rawTasksJson = System.Text.Json.JsonSerializer.Serialize(Model.Tasks);
    string tasksBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(rawTasksJson));
}

<div class="container py-4">

    <div class="mb-3">
        <a asp-action="Plan" class="text-decoration-none text-success fw-semibold">
            ← Back to AI Form
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-2">
                    ✨ AI Generated Project Plan
                </span>
                <h1 class="fw-bold mb-1">🌱 @Model.ProjectTitle</h1>
                <p class="text-muted fs-5 mb-0">Plant: <strong>@Model.PlantName</strong></p>
            </div>
            <div>
                <a asp-action="Plan" class="btn btn-outline-secondary rounded-pill">
                    🔄 Regenerate Plan
                </a>
            </div>
        </div>

        <!-- OVERVIEW & RECOMMENDATIONS -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h5 class="fw-bold mb-2">📝 Summary</h5>
                    <p class="text-secondary mb-0">@Model.Summary</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <h5 class="fw-bold mb-2">💡 Key Recommendations</h5>
                    <p class="text-secondary mb-0">@Model.Recommendations</p>
                </div>
            </div>
        </div>

        <form asp-action="CreateFromPlan" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="tasksBase64" value="@tasksBase64" />

            <!-- EDITABLE PROJECT ATTRIBUTES -->
            <h4 class="fw-bold mb-3">Project Attributes</h4>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Plant Name</label>
                    <input name="plantName" value="@Model.PlantName" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Location / Environment</label>
                    <input name="location" value="@(origReq?.Location ?? "Garden")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Soil Type</label>
                    <input name="soilType" value="@(origReq?.SoilType ?? "General Mix")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Space (m²)</label>
                    <input name="space" type="number" step="0.1" value="@(origReq?.Space ?? 2.0)" class="form-control" required />
                </div>
            </div>

            <!-- GENERATED TASKS -->
            <h4 class="fw-bold mb-3">Generated Tasks (@Model.Tasks.Count)</h4>
            <div class="d-flex flex-column gap-3 mb-4">
                @for (int i = 0; i < Model.Tasks.Count; i++)
                {
                    var task = Model.Tasks[i];
                    string badgeBg = task.Difficulty switch
                    {
                        "Easy" => "bg-info-subtle text-info border-info-subtle",
                        "Medium" => "bg-warning-subtle text-warning border-warning-subtle",
                        "Hard" => "bg-danger-subtle text-danger border-danger-subtle",
                        _ => "bg-secondary-subtle text-secondary"
                    };

                    <div class="card border rounded-3 p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold">Step @(i + 1):</span>
                                    <h5 class="fw-bold mb-0">@task.Title</h5>
                                    <span class="badge border @badgeBg rounded-pill px-2 py-1 ms-2">
                                        @task.Difficulty · +@task.XpReward XP
                                    </span>
                                </div>
                                <p class="text-muted small mb-1">@task.Description</p>
                                @if (!string.IsNullOrWhiteSpace(task.Timing))
                                {
                                    <small class="text-success fw-semibold">⏱️ Timing: @task.Timing</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="p-4 bg-success-subtle border border-success-subtle rounded-4 text-center">
                <h5 class="fw-bold text-success-emphasis mb-2">Ready to start growing?</h5>
                <p class="text-muted mb-3">Clicking below will save this project and insert these AI-generated tasks into your garden workspace.</p>
                <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold">
                    🌱 Create This Project
                </button>
            </div>
        </form>
    </div>

</div>

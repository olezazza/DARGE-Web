@model List<Darge.Web.Models.Project>

@{
    ViewData["Title"] = "My Projects";
}

<div class="container-fluid py-2">

    <!-- WORKSPACE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-slate-900">📁 Projects Workspace</h2>
            <p class="text-slate-500 mb-0">Manage your growing crops, garden beds, and AI-generated plans.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Plan" class="btn btn-outline-success rounded-pill px-4">
                ✨ Plan with DARGE AI
            </a>
            <a asp-action="Create" class="btn btn-emerald rounded-pill px-4">
                + New Project
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white my-4">
            <div class="fs-1 mb-3">🪴</div>
            <h3 class="fw-bold text-slate-900 mb-2">No projects found</h3>
            <p class="text-slate-500 max-w-md mx-auto mb-4">Start tracking your plants and crops. You can create a manual project or let DARGE AI design a tailored plan.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Plan" class="btn btn-emerald btn-lg rounded-pill px-4">
                    ✨ Plan with DARGE AI
                </a>
                <a asp-action="Create" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                    Create Manual Project
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var project in Model)
            {
                int completed = project.Tasks.Count(t => t.IsCompleted);
                int total = project.Tasks.Count;
                double pct = total == 0 ? 0 : Math.Round((double)completed / total * 100);
                var nextTask = project.Tasks.FirstOrDefault(t => !t.IsCompleted);

                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 bg-white card-hover p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="fw-bold text-slate-900 mb-0">🌱 @project.PlantName</h4>
                                <span class="badge badge-emerald rounded-pill px-3 py-1">
                                    @project.Space m²
                                </span>
                            </div>

                            <div class="text-slate-500 small mb-3">
                                @if (!string.IsNullOrWhiteSpace(project.Location))
                                {
                                    <div class="mb-1">📍 <strong>Location:</strong> @project.Location</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.SoilType))
                                {
                                    <div>🪨 <strong>Soil:</strong> @project.SoilType</div>
                                }
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-slate-600 fw-semibold mb-1">
                                    <span>Task Progress</span>
                                    <span>@completed / @total Tasks (@pct%)</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 8px;">
                                    <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: @pct%"></div>
                                </div>
                            </div>

                            @if (nextTask != null)
                            {
                                <div class="p-2 bg-slate-100 rounded-2 small text-slate-700 mb-3">
                                    <span class="fw-bold text-slate-900">Next Action:</span> @nextTask.TaskName
                                </div>
                            }
                            else if (total > 0)
                            {
                                <div class="p-2 bg-success-subtle text-success rounded-2 small mb-3 fw-bold">
                                    ✓ All tasks complete
                                </div>
                            }
                            else
                            {
                                <div class="p-2 bg-slate-100 text-muted rounded-2 small mb-3">
                                    No tasks assigned yet
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-success w-100 rounded-pill">
                                Open Details
                            </a>
                            <a asp-action="Assistant" asp-route-id="@project.Id" class="btn btn-emerald w-100 rounded-pill">
                                🤖 AI Assistant
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
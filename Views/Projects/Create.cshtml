@{
    ViewData["Title"] = "New Project";
}

<div class="container mt-5"
     style="max-width: 650px;">

    <h1>New Project</h1>

    <p>
        Start growing something.
    </p>


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">

            @ViewBag.Error

        </div>
    }


    <form asp-action="Create"
          method="post">


        <div class="mb-3">

            <label class="form-label">
                Plant
            </label>

            <input
                name="plantName"
                class="form-control"
                required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Location
            </label>

            <input
                name="location"
                class="form-control" />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Soil Type
            </label>

            <input
                name="soilType"
                class="form-control" />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Space (m²)
            </label>

            <input
                name="space"
                type="number"
                step="0.01"
                min="0.01"
                class="form-control"
                required />

        </div>


        <button
            class="btn btn-success"
            type="submit">

            Create Project

        </button>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>

    </form>

</div>
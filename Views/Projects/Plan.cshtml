@inject Darge.Web.Services.ILocalizationService Loc
@model Darge.Web.Models.AiProjectPlanRequest

@{
    ViewData["Title"] = Loc.Get("PlanWithAITitle");
}

<div class="container py-3" style="max-width: 760px;">

    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-emerald fw-semibold">
            ← @Loc.Get("ProjectsWorkspaceTitle")
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="fs-1">✨</span>
            <div>
                <h2 class="fw-bold mb-0 text-slate-900">@Loc.Get("PlanWithAITitle")</h2>
                <p class="text-slate-600 mb-0">@Loc.Get("PlanWithAISub")</p>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-3 mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <strong>Generation Error:</strong> @ViewBag.Error
                </div>
            </div>
        }

        <form asp-action="GeneratePlan" method="post" id="aiPlanForm">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("PlantNameLabel") <small class="text-muted">(Optional)</small></label>
                    <input asp-for="PlantName" class="form-control rounded-3" placeholder="e.g. Tomatoes / პომიდორი" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("LocationLabel")</label>
                    <input asp-for="Location" class="form-control rounded-3" placeholder="e.g. Tbilisi, Georgia" required />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("EnvironmentLabel")</label>
                    <select asp-for="Environment" class="form-select rounded-3" required>
                        <option value="Sunny Balcony">@Loc.Get("Sunny Balcony")</option>
                        <option value="Backyard Garden">@Loc.Get("Backyard Garden")</option>
                        <option value="Greenhouse">@Loc.Get("Greenhouse")</option>
                        <option value="Indoor / Windowsill">@Loc.Get("Indoor / Windowsill")</option>
                        <option value="Raised Bed">@Loc.Get("Raised Bed")</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("SpaceLabel")</label>
                    <input asp-for="Space" type="number" step="0.1" min="0.1" class="form-control rounded-3" required />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("SoilType") <small class="text-muted">(Optional)</small></label>
                    <input asp-for="SoilType" class="form-control rounded-3" placeholder="e.g. Loam, Potted mix" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("ExperienceLabel")</label>
                    <select asp-for="ExperienceLevel" class="form-select rounded-3">
                        <option value="Beginner" selected>@Loc.Get("Beginner")</option>
                        <option value="Intermediate">@Loc.Get("Intermediate")</option>
                        <option value="Advanced">@Loc.Get("Advanced")</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold text-slate-700">@Loc.Get("GoalLabel") <small class="text-muted">(Optional)</small></label>
                    <textarea asp-for="Goal" class="form-control rounded-3" rows="3" placeholder="e.g. Easy edible crop, high yield, low maintenance..."></textarea>
                </div>
            </div>

            <div class="mt-4 pt-2 d-flex flex-column flex-sm-row gap-3">
                <button type="submit" class="btn btn-emerald btn-lg rounded-pill px-5 fw-bold w-100 w-sm-auto" id="generateBtn">
                    ✨ @Loc.Get("GeneratePlanBtn")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 text-center">
                    Cancel
                </a>
            </div>

            <!-- LOADING INDICATOR -->
            <div id="loadingBox" class="d-none mt-4 p-4 surface-ai border rounded-4 text-center">
                <div class="spinner-border text-emerald mb-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold mb-1 text-slate-900">DARGE AI is designing your project...</h5>
                <p class="text-slate-700 small mb-0">Analyzing climate, space, and task sequence in your selected language.</p>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('aiPlanForm').addEventListener('submit', function () {
            var btn = document.getElementById('generateBtn');
            var loadingBox = document.getElementById('loadingBox');
            btn.disabled = true;
            btn.innerHTML = '✨ Generating Plan...';
            loadingBox.classList.remove('d-none');
        });
    </script>
}

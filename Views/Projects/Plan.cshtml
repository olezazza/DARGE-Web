@model Darge.Web.Models.AiProjectPlanRequest

@{
    ViewData["Title"] = "Plan with DARGE AI";
}

<div class="container py-4" style="max-width: 720px;">

    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-success fw-semibold">
            ← Back to Projects
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="fs-1">✨</span>
            <div>
                <h2 class="fw-bold mb-0">Plan with DARGE AI</h2>
                <p class="text-muted mb-0">Describe your environment and DARGE AI will build a complete project plan.</p>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-3 mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <strong>Generation Failed:</strong> @ViewBag.Error
                </div>
            </div>
        }

        <form asp-action="GeneratePlan" method="post" id="aiPlanForm">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Plant Name <small class="text-muted">(Optional)</small></label>
                    <input asp-for="PlantName" class="form-control" placeholder="e.g. Tomatoes (or leave blank for AI recommendation)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Location / City / Region</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Tbilisi, Georgia" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Growing Environment</label>
                    <select asp-for="Environment" class="form-select" required>
                        <option value="Sunny Balcony">Sunny Balcony</option>
                        <option value="Backyard Garden">Backyard Garden</option>
                        <option value="Greenhouse">Greenhouse</option>
                        <option value="Indoor / Windowsill">Indoor / Windowsill</option>
                        <option value="Raised Bed">Raised Bed</option>
                        <option value="Shaded Patio">Shaded Patio</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Available Space (m²)</label>
                    <input asp-for="Space" type="number" step="0.1" min="0.1" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Soil Type <small class="text-muted">(Optional)</small></label>
                    <input asp-for="SoilType" class="form-control" placeholder="e.g. Potted Mix, Clay, Loam" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Experience Level</label>
                    <select asp-for="ExperienceLevel" class="form-select">
                        <option value="Beginner" selected>Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Your Goal / Preferences <small class="text-muted">(Optional)</small></label>
                    <textarea asp-for="Goal" class="form-control" rows="3" placeholder="e.g. I want something edible, high yield, low effort that grows fast."></textarea>
                </div>
            </div>

            <div class="mt-4 pt-2 d-flex gap-3">
                <button type="submit" class="btn btn-success btn-lg rounded-pill px-4" id="generateBtn">
                    ✨ Generate Project Plan
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    Cancel
                </a>
            </div>

            <!-- LOADING INDICATOR -->
            <div id="loadingBox" class="d-none mt-4 p-4 bg-light border rounded-4 text-center">
                <div class="spinner-border text-success mb-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold mb-1">DARGE AI is designing your project...</h5>
                <p class="text-muted small mb-0">Analyzing climate, space, and task sequence. This takes a few seconds.</p>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('aiPlanForm').addEventListener('submit', function () {
            var btn = document.getElementById('generateBtn');
            var loadingBox = document.getElementById('loadingBox');
            btn.disabled = true;
            btn.innerHTML = '✨ Generating Plan...';
            loadingBox.classList.remove('d-none');
        });
    </script>
}

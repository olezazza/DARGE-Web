@inject Darge.Web.Services.ILocalizationService Loc
@model Darge.Web.Models.Project

@{
    ViewData["Title"] = $"{Model.PlantName} - {Loc.Get("DedicatedAI")}";
    var conversations = ViewBag.Conversations as List<Darge.Web.Models.AiConversation> ?? new List<Darge.Web.Models.AiConversation>();
    var activeConv = ViewBag.ActiveConversation as Darge.Web.Models.AiConversation;
    int activeConvId = activeConv?.Id ?? 0;

    int completed = Model.Tasks.Count(t => t.IsCompleted);
    int total = Model.Tasks.Count;
    double pct = total == 0 ? 0 : Math.Round((double)completed / total * 100);

    string? proposedBase64 = TempData["ProposedActionsBase64"] as string;
    List<Darge.Web.Models.ProposedAction>? proposedActions = null;

    if (!string.IsNullOrWhiteSpace(proposedBase64))
    {
        try
        {
            string json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(proposedBase64));
            proposedActions = System.Text.Json.JsonSerializer.Deserialize<List<Darge.Web.Models.ProposedAction>>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch {}
    }
}

<div class="container-fluid py-2">

    <!-- PAGE HEADER INSIDE CONTENT -->
    <div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-emerald fw-semibold">
            ← @Model.PlantName @Loc.Get("OpenDetails")
        </a>
        <span class="badge badge-ai px-3 py-1 rounded-pill fs-6">
            🤖 @Loc.Get("DedicatedAI")
        </span>
    </div>

    <div class="row g-4">

        <!-- CHAT COLUMN (LEFT) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white d-flex flex-column" style="min-height: 75vh;">

                <!-- CONVERSATION BAR / TOP HEADER -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between surface-ai rounded-top-4 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">🌱</span>
                        <div>
                            <h5 class="fw-bold mb-0 text-ai">@Model.PlantName AI Assistant</h5>
                            <small class="text-slate-600">@(activeConv?.Title ?? "Project Conversation")</small>
                        </div>
                    </div>

                    <!-- CHAT SELECTOR & NEW CHAT -->
                    <div class="d-flex align-items-center gap-2">
                        @if (conversations.Count > 1)
                        {
                            <select class="form-select form-select-sm rounded-pill border-secondary" style="max-width: 200px;" onchange="location.href='@Url.Action("Assistant", "Projects", new { id = Model.Id })?conversationId=' + this.value;">
                                @foreach (var c in conversations)
                                {
                                    <option value="@c.Id" selected="@(c.Id == activeConvId)">@c.Title</option>
                                }
                            </select>
                        }

                        <form asp-action="AskAi" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.Id" />
                            <input type="hidden" name="conversationId" value="0" />
                            <input type="hidden" name="question" value="Hello! What should I do for my project?" />
                            <button type="submit" class="btn btn-sm btn-emerald rounded-pill">
                                + New Chat
                            </button>
                        </form>
                    </div>
                </div>

                <!-- CHAT MESSAGES TRANSCRIPT -->
                <div class="card-body p-4 flex-grow-1 overflow-auto" id="chatContainer" style="max-height: 520px;">
                    
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success rounded-3 mb-3">
                            @TempData["Message"]
                        </div>
                    }

                    @if (TempData["AiError"] != null)
                    {
                        <div class="alert alert-danger rounded-3 mb-3">
                            @TempData["AiError"]
                        </div>
                    }

                    <!-- SYSTEM INITIAL CONTEXT BUBBLE -->
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <div class="bg-emerald text-white rounded-circle p-2 fs-5">🤖</div>
                        <div class="p-3 rounded-4 surface-ai text-dark max-w-xl">
                            <p class="fw-bold mb-1">Hello! I am DARGE AI for <strong>@Model.PlantName</strong>.</p>
                            <p class="mb-0 small text-slate-700">
                                I am aware of your project specs (@Model.Space m², @(string.IsNullOrWhiteSpace(Model.Location) ? "Garden" : Model.Location)), soil, and your @total tasks. Ask any question or request project changes.
                            </p>
                        </div>
                    </div>

                    <!-- PERSISTENT TRANSCRIPT MESSAGES -->
                    @if (activeConv?.Messages != null && activeConv.Messages.Count > 0)
                    {
                        foreach (var msg in activeConv.Messages)
                        {
                            if (msg.Role == "user")
                            {
                                <div class="d-flex justify-content-end mb-3">
                                    <div class="p-3 rounded-4 bg-emerald text-white max-w-xl shadow-sm">
                                        <p class="mb-0 fw-semibold">@msg.Content</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-start gap-3 mb-4">
                                    <div class="bg-emerald text-white rounded-circle p-2 fs-5">🤖</div>
                                    <div class="p-4 rounded-4 surface-ai text-dark max-w-xl shadow-sm">
                                        <p class="fw-bold text-ai mb-2">🌱 DARGE AI Response:</p>
                                        <div class="ai-formatted-text text-slate-800" style="line-height: 1.7; white-space: pre-wrap;">@msg.Content</div>
                                    </div>
                                </div>
                            }
                        }
                    }

                    <!-- PROPOSED ACTIONS CARD (REQ 5) -->
                    @if (proposedActions != null && proposedActions.Count > 0)
                    {
                        <div class="card border-0 shadow surface-task p-4 mb-4 rounded-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fs-4">💡</span>
                                <h5 class="fw-bold text-task mb-0">AI Proposed Project Changes</h5>
                            </div>
                            <p class="text-slate-700 small mb-3">DARGE AI recommends applying these updates to your project database. Review and confirm below:</p>

                            <div class="d-flex flex-column gap-2 mb-3">
                                @foreach (var act in proposedActions)
                                {
                                    if (act.ActionType == "ADD_TASK")
                                    {
                                        <div class="p-3 bg-white border rounded-3 text-slate-800">
                                            <div class="fw-bold text-slate-900 mb-1">➕ Add Task: @act.TaskTitle</div>
                                            @if (!string.IsNullOrWhiteSpace(act.TaskDescription))
                                            {
                                                <small class="text-slate-600 d-block mb-1">@act.TaskDescription</small>
                                            }
                                            <span class="badge badge-task">@act.Difficulty</span>
                                            <span class="text-xp fw-bold small ms-2">+@act.XpReward XP</span>
                                        </div>
                                    }
                                    else if (act.ActionType == "UPDATE_PROJECT_INFO")
                                    {
                                        <div class="p-3 bg-white border rounded-3 text-slate-800">
                                            <div class="fw-bold text-slate-900 mb-1">📝 Update Project Specifications:</div>
                                            @if (!string.IsNullOrWhiteSpace(act.NewLocation))
                                            {
                                                <small class="d-block text-slate-700">📍 Location: <s>@Model.Location</s> → <strong>@act.NewLocation</strong></small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(act.NewSoilType))
                                            {
                                                <small class="d-block text-slate-700">🪨 Soil: <s>@Model.SoilType</s> → <strong>@act.NewSoilType</strong></small>
                                            }
                                            @if (act.NewSpace.HasValue && act.NewSpace.Value > 0)
                                            {
                                                <small class="d-block text-slate-700">📐 Space: <s>@Model.Space m²</s> → <strong>@act.NewSpace.Value m²</strong></small>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <form asp-action="ApplyProposedActions" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectId" value="@Model.Id" />
                                <input type="hidden" name="conversationId" value="@activeConvId" />
                                <input type="hidden" name="actionsBase64" value="@proposedBase64" />
                                <button type="submit" class="btn btn-emerald rounded-pill px-4">
                                    ✓ Apply Changes
                                </button>
                                <a asp-action="Assistant" asp-route-id="@Model.Id" asp-route-conversationId="@activeConvId" class="btn btn-outline-secondary rounded-pill px-4">
                                    Cancel
                                </a>
                            </form>
                        </div>
                    }

                </div>

                <!-- STARTER PROMPTS & CHAT INPUT -->
                <div class="p-3 border-top surface-ai rounded-bottom-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <small class="text-slate-600 fw-semibold me-1">@Loc.Get("StarterPrompts")</small>
                        <button type="button" class="btn btn-sm btn-white border rounded-pill" onclick="setPrompt('What should I do this week for @Model.PlantName?')">
                            @Loc.Get("WhatToDoThisWeek")
                        </button>
                        <button type="button" class="btn btn-sm btn-white border rounded-pill" onclick="setPrompt('Is my project on schedule?')">
                            @Loc.Get("IsOnSchedule")
                        </button>
                        <button type="button" class="btn btn-sm btn-white border rounded-pill" onclick="setPrompt('Add 2 care tasks for protecting these plants during high heat.')">
                            Propose Heat Tasks
                        </button>
                    </div>

                    <form asp-action="AskAi" method="post" id="chatForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <input type="hidden" name="conversationId" value="@activeConvId" />

                        <div class="input-group input-group-lg">
                            <input name="question" id="chatInput" class="form-control rounded-start-pill fs-6" placeholder="Ask DARGE AI or request project task changes..." required maxlength="500" />
                            <button type="submit" class="btn btn-emerald rounded-end-pill px-4" id="sendBtn">
                                @Loc.Get("AskAIBtn")
                            </button>
                        </div>
                    </form>

                    <div id="thinkingBox" class="d-none mt-2 text-slate-600 small text-center">
                        <span class="spinner-border spinner-border-sm text-emerald me-1"></span>
                        DARGE AI is processing your message...
                    </div>
                </div>

            </div>
        </div>

        <!-- RIGHT CONTEXTUAL PANEL -->
        <div class="col-lg-4">
            <button class="btn btn-outline-secondary btn-sm w-100 rounded-pill mb-2 d-lg-none d-flex align-items-center justify-content-between px-3" type="button" data-bs-toggle="collapse" data-bs-target="#projectContextCollapse" aria-expanded="false">
                <span>📋 @Model.PlantName Context</span>
                <span>▼</span>
            </button>

            <div class="collapse d-lg-block" id="projectContextCollapse">
                <div class="card border-0 shadow-sm surface-project p-4 sticky-top mb-4 mb-lg-0" style="top: 20px;">
                    <h4 class="fw-bold text-slate-900 mb-3">📋 Project Context</h4>

                    <div class="p-3 bg-white rounded-3 border mb-3">
                        <h5 class="fw-bold mb-1 text-slate-900">🌱 @Model.PlantName</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <p class="text-slate-600 small mb-1">📍 <strong>@Loc.Get("Location"):</strong> @Model.Location</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SoilType))
                        {
                            <p class="text-slate-600 small mb-1">🪨 <strong>@Loc.Get("SoilType"):</strong> @Model.SoilType</p>
                        }
                        <p class="text-slate-600 small mb-0">📐 <strong>@Loc.Get("Space"):</strong> @Model.Space m²</p>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between small fw-bold text-slate-700 mb-1">
                            <span>@Loc.Get("TaskCompletion")</span>
                            <span>@completed / @total Tasks (@pct%)</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: @pct%"></div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-slate-900 mb-2">@Loc.Get("TasksToDo") (@Model.Tasks.Count(t => !t.IsCompleted))</h5>
                    @if (!Model.Tasks.Any(t => !t.IsCompleted))
                    {
                        <div class="p-3 bg-success-subtle text-success border border-success-subtle rounded-3 small fw-bold">
                            🎉 @Loc.Get("AllTasksComplete")
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var task in Model.Tasks.Where(t => !t.IsCompleted))
                            {
                                <div class="p-2 border rounded-3 bg-white small">
                                    <div class="fw-bold text-slate-900 mb-1">@task.TaskName</div>
                                    @if (!string.IsNullOrWhiteSpace(task.TaskLevel))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary me-2">@task.TaskLevel</span>
                                    }
                                    <small class="text-xp fw-bold">+@task.XpReward XP</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function setPrompt(text) {
            document.getElementById('chatInput').value = text;
        }

        document.getElementById('chatForm').addEventListener('submit', function () {
            var btn = document.getElementById('sendBtn');
            var thinking = document.getElementById('thinkingBox');
            if (btn && thinking) {
                btn.disabled = true;
                btn.innerHTML = 'Thinking...';
                thinking.classList.remove('d-none');
            }
        });

        var container = document.getElementById('chatContainer');
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    </script>
}

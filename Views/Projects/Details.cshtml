@inject Darge.Web.Services.ILocalizationService Loc
@model Darge.Web.Models.Project

@{
    ViewData["Title"] = Model.PlantName;

    int completed = Model.Tasks.Count(t => t.IsCompleted);
    int total = Model.Tasks.Count;
    int pending = total - completed;
    double progress = total == 0 ? 0 : Math.Round((double)completed / total * 100);

    var pendingTasks = Model.Tasks.Where(t => !t.IsCompleted).ToList();
    var completedTasks = Model.Tasks.Where(t => t.IsCompleted).ToList();
}

<div class="container-fluid py-2">

    <!-- PROJECT NAVIGATION & ACTIONS HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-emerald fw-semibold mb-1 d-inline-block">
                ← @Loc.Get("BackToProjects")
            </a>
            <h2 class="fw-bold text-slate-900 mb-0">🌱 @Model.PlantName</h2>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <a asp-action="Assistant" asp-route-id="@Model.Id" class="btn btn-emerald rounded-pill px-4">
                🤖 @Loc.Get("OpenAIAssistant")
            </a>

            <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this project?');" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger rounded-pill">
                    🗑️ @Loc.Get("DeleteProject")
                </button>
            </form>
        </div>
    </div>

    <!-- PROJECT SPECIFICATIONS CARD -->
    <div class="card border-0 shadow-sm surface-project p-4 mb-4">
        <div class="row g-3 text-slate-700 mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div class="col-6 col-md-3">
                    <small class="text-uppercase fw-bold text-project d-block mb-1">@Loc.Get("Location")</small>
                    <span class="fs-6 fw-semibold">📍 @Model.Location</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SoilType))
            {
                <div class="col-6 col-md-3">
                    <small class="text-uppercase fw-bold text-project d-block mb-1">@Loc.Get("SoilType")</small>
                    <span class="fs-6 fw-semibold">🪨 @Model.SoilType</span>
                </div>
            }
            <div class="col-6 col-md-3">
                <small class="text-uppercase fw-bold text-project d-block mb-1">@Loc.Get("Space")</small>
                <span class="fs-6 fw-semibold">📐 @Model.Space m²</span>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-uppercase fw-bold text-project d-block mb-1">@Loc.Get("TasksDone")</small>
                <span class="fs-6 fw-semibold">✅ @completed / @total (@progress%)</span>
            </div>
        </div>

        <hr class="my-2" />

        <div class="mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-slate-900 small">@Loc.Get("TaskCompletion")</span>
                <span class="text-slate-600 small">@pending @Loc.Get("PendingActions")</span>
            </div>
            <div class="progress rounded-pill" style="height: 12px;">
                <div class="progress-bar progress-bar-emerald rounded-pill" role="progressbar" style="width: @progress%"></div>
            </div>
        </div>
    </div>

    <!-- TASKS & ADD TASK GRID -->
    <div class="row g-4">

        <!-- TASKS SECTIONS (LEFT COLUMN) -->
        <div class="col-lg-8">

            <!-- TO DO / PENDING TASKS -->
            <div class="card border-0 shadow-sm bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-slate-900 mb-0">⏳ @Loc.Get("TasksToDo") (@pendingTasks.Count)</h4>
                    <span class="badge badge-task px-3 py-1 rounded-pill small fw-bold">
                        @Loc.Get("PendingActions")
                    </span>
                </div>

                @if (pendingTasks.Count == 0)
                {
                    <div class="p-4 bg-slate-100 rounded-3 text-center">
                        <div class="fs-2 mb-2">🎉</div>
                        <h5 class="fw-bold text-slate-900 mb-1">@Loc.Get("AllCaughtUp")</h5>
                        <p class="text-slate-600 small mb-0">@Loc.Get("NoPendingTasks")</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var task in pendingTasks)
                        {
                            string badgeClass = task.TaskLevel switch
                            {
                                "Easy" => "bg-info-subtle text-info border-info-subtle",
                                "Medium" => "bg-warning-subtle text-warning border-warning-subtle",
                                "Hard" => "bg-danger-subtle text-danger border-danger-subtle",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <div class="p-3 border rounded-3 surface-task d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <h5 class="fw-bold text-slate-900 mb-1">@task.TaskName</h5>
                                    @if (!string.IsNullOrWhiteSpace(task.TaskDescription))
                                    {
                                        <p class="text-slate-600 small mb-2">@task.TaskDescription</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(task.TaskLevel))
                                    {
                                        <span class="badge border @badgeClass me-2">@task.TaskLevel</span>
                                    }
                                    <span class="text-xp fw-bold small">+@task.XpReward XP</span>
                                </div>

                                <div class="d-flex gap-2">
                                    <form asp-action="CompleteTask" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-emerald btn-sm rounded-pill px-3">
                                            ✓ @Loc.Get("Complete")
                                        </button>
                                    </form>

                                    <form asp-action="DeleteTask" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                            @Loc.Get("Delete")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- COMPLETED TASKS -->
            <div class="card border-0 shadow-sm bg-white p-4">
                <h4 class="fw-bold text-slate-900 mb-3">✅ @Loc.Get("CompletedTasks") (@completedTasks.Count)</h4>

                @if (completedTasks.Count == 0)
                {
                    <p class="text-slate-600 small mb-0">No completed tasks yet.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var task in completedTasks)
                        {
                            <div class="p-3 border rounded-3 bg-slate-100 opacity-75 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-decoration-line-through text-slate-700">@task.TaskName</span>
                                    @if (!string.IsNullOrWhiteSpace(task.TaskLevel))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border ms-2">@task.TaskLevel</span>
                                    }
                                </div>
                                <span class="text-emerald fw-bold small">+@task.XpReward XP</span>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- ADD TASK FORM (RIGHT COLUMN) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm bg-white p-4 sticky-top" style="top: 20px;">
                <h4 class="fw-bold text-slate-900 mb-3">➕ @Loc.Get("AddNewTask")</h4>

                <form asp-action="AddTask" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">@Loc.Get("TaskName")</label>
                        <input name="taskName" class="form-control rounded-3" placeholder="e.g. Water plants, Check soil pH" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">@Loc.Get("Description")</label>
                        <textarea name="taskDescription" class="form-control rounded-3" rows="3" placeholder="Optional details..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-slate-700">@Loc.Get("DifficultyLevel")</label>
                        <select name="taskLevel" class="form-select rounded-3">
                            <option value="Easy">@Loc.Get("Easy") (10 XP)</option>
                            <option value="Medium" selected>@Loc.Get("Medium") (20 XP)</option>
                            <option value="Hard">@Loc.Get("Hard") (30 XP)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-emerald w-100 rounded-pill py-2">
                        @Loc.Get("AddNewTask")
                    </button>
                </form>
            </div>
        </div>

    </div>

</div>